# ── Proof Gatekeeper agent configuration ─────────────────────────────────────
# Copy to ".env" and fill in. NEVER commit .env. NEVER paste real values into
# chat, prompts, or logs.

# REQUIRED. The platform-generated HMAC secret: dashboard → Rotate Secret →
# copy the one-time plaintext here. A placeholder value fails preflight.
AGENT_GAMES_HMAC_SECRET=

# Kurier (zkVerify) REST API key. Get one at kurier.xyz (mainnet) — the
# gatekeeper VK is registered on zkVerify MAINNET (see /api/circuit-info).
# If left blank, proofs are generated and locally verified but NOT submitted
# to zkVerify, and APPROVE does not wait for finalization (practice mode).
KURIER_API_KEY=

# Kurier base URL. Mainnet: https://api.kurier.xyz/api/v1
# Testnet (plumbing tests only — the competition VK hash is mainnet):
# https://api-testnet.kurier.xyz/api/v1
KURIER_API_URL=https://api.kurier.xyz/api/v1

# HTTP listen port and the registered handler path. Register the FULL path
# (e.g. https://your-host/agent) on the dashboard — not just the root.
PORT=8080
AGENT_PATH=/agent

# The gatekeeper circuit's registered VK hash (from
# https://agentgames.zkverify.io/api/circuit-info). The decision engine
# rejects any task whose registered_vk differs from this value.
GATEKEEPER_VK_HASH=0x6b79c6012a6d8651f3e13bc4d2a20370280ab49700c90c5316d4168bfbad77b0

# Overall per-task response budget in ms (platform hard deadline is 60s).
RESPONSE_BUDGET_MS=55000

# When a KURIER_API_KEY is set: require a Finalized zkVerify result before
# returning APPROVE (checklist: "finalized before approval"). On timeout the
# agent fails closed with REJECT / FINALIZATION_TIMEOUT.
KURIER_REQUIRED_FOR_APPROVE=true
KURIER_POLL_INTERVAL_MS=2000
# How long a REJECT response may wait for Kurier finalization before it is
# sent with the proof alone (finalization never gates a rejection).
REJECT_KURIER_WAIT_MS=5000

# Outbound signature format for x-agent-games-signature: "hex" (default) or
# "sha256-hex" (sends "sha256=<hex>"). Inbound verification accepts both.
# If preflight fails with a signature error, try the other format.
SIGNATURE_FORMAT=hex

# How the envelope's string task_id is encoded into the circuit's taskId
# field element: "keccak" (keccak256 of the UTF-8 task_id, mod p — default),
# "numeric" (task_id must be all digits), or "hex" (task_id is / ends with
# hex). Validate against the platform's unscored practice tasks first.
TASK_ID_ENCODING=keccak

# Optional direct TLS (otherwise terminate TLS at your host / reverse proxy —
# the platform requires a public HTTPS URL on the standard port).
# TLS_CERT_FILE=
# TLS_KEY_FILE=

# Runtime state file (seen proof references + idempotent task responses).
STORE_PATH=data/store.json
